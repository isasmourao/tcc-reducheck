// Verly et al. (2024) - bone remodeling during menopause, original model.
//
// 11 state variables: D, Mo, M1, M2, C1, C2, Cm, Cb, Mc, Mb, E2. Parameter,
// variable and function names follow `bonerepair` in the original code
// (referencia/bone_estradiol.py). Two equations follow the dissertation
// instead of that code:
//
//   * RM = kmax * (1 - M / Mmax) * D (the code omits the factor D);
//   * the logistic term of Cb is Ab * Cb * (1 - Cb) / k_lb (the code uses
//     Ab * Cb * (1 - Cb / k_lb)).
//
// The state variables are plain ODE variables (rate rules), not species in a
// compartment, so that no compartment volume scales the equations.

model verly_original

  // --- Parameters
  ke_1  = 3.0;
  ke_2  = 3.0;
  a_ed  = 4.71e6;    // unused; RD uses aed
  d_o   = 0.156;
  k_12  = 0.075;
  k_21  = 0.005;
  d_1   = 0.121;
  d_2   = 0.163;
  k_o   = 0.0000005;
  k_1   = 0.0000083;
  d_c1  = 0.2;
  k_2   = 0.00000372;
  k_3   = 0.0000007;
  d_c2  = 0.25;
  K_lm  = 1000000.0;
  k_lb  = 1000000.0;
  d_b   = 0.15;
  p_cs  = 0.000003;
  q_cd1 = 0.000003;
  q_cd2 = 0.000002;
  p_bs  = 0.00000005;
  q_bd  = 0.00000005;
  aed   = 4.71e6;
  kmax  = 0.015;
  Mmax  = 6.0e5;
  k_01  = 0.55;
  a_01  = 0.01;
  k_02  = 0.3;
  a_02  = 0.005;
  a_12  = 0.025;
  a_22  = 0.1;
  kpm   = 0.5;
  apm   = 3.162;
  apm1  = 13.0;
  dm    = 1.0;
  amb1  = 0.1;
  kpb   = 0.2202;
  apb   = 10.0;
  ae2   = 0.5;
  de2   = 0.03;

  // E2max is the initial value of E2 (premenopause scenario).
  E2max = 0.060;

  // --- Auxiliary functions
  M  := Mo + M1 + M2;                                  // total macrophages
  RD := D / (aed + D);                                 // phagocytosis rate
  RM := kmax * (1 - M / Mmax) * D;                     // migration of Mo
  G1 := k_01 * (C1 / (a_01 + C1));                     // Mo -> M1
  G2 := k_02 * (C2 / (a_02 + C2));                     // Mo -> M2
  H1 := a_12 / (a_12 + C2);                            // inhibition by C2
  H2 := a_22 / (a_22 + C2);                            // inhibition by C2
  Am := kpm * ((apm * apm) + (apm1 * C1)) / ((apm * apm) + (C1 * C1));
  F1 := dm * (amb1 / (amb1 + C1));                     // Cm -> Cb
  Ab := kpb * (apb / (apb + C1));                      // proliferation of Cb

  // --- Equations (one per state variable)
  D'  = -RD * (ke_1 * M1 + ke_2 * M2);
  Mo' = RM - G1 * Mo - G2 * Mo - (d_o * Mo);
  M1' = G1 * Mo + (k_21 * M2) - (k_12 * M1) - (d_1 * M1);
  M2' = G2 * Mo + (k_12 * M1) - (k_21 * M2) - (d_2 * M2);
  C1' = H1 * (k_o * D + k_1 * M1) - (d_c1 * C1) * E2;
  C2' = H2 * (k_2 * M2 + k_3 * Cm) * E2 - (d_c2 * C2);
  Cm' = Am * Cm * (1 - (Cm / K_lm)) - (F1 * Cm);
  Cb' = Ab * Cb * (1 - Cb) / k_lb + (F1 * Cm) - (d_b * Cb);
  Mc' = (p_cs - q_cd1 * Mc) * Cm - (q_cd2 * Mc * Cb);
  Mb' = (p_bs - (q_bd * Mb)) * Cb;
  E2' = ((E2max - E2) / E2max) * ae2 * E2 - de2 * E2;

  // --- Initial conditions
  D  = 1000000.0;
  Mo = 4000.0;
  M1 = 0.0;
  M2 = 0.0;
  C1 = 0.0;
  C2 = 0.0;
  Cm = 2500.0;
  Cb = 0.0;
  Mc = 0.0;
  Mb = 0.0;
  E2 = 0.060;

end
