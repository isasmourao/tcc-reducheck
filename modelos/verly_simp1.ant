// Verly et al. (2024) - bone remodeling during menopause, SIMPLIFICATION 1.
//
// Source of the equations: `referencia/simplificacao_2026-04-22.md` (note by
// Verly, Mourao and Quintela, 2026-04-22), which is the document behind
// section 4.1 of `docs/tcc1.pdf`. There is no official code for it.
// Everything else comes from `modelos/verly_original.ant`, the checked
// transcription of `referencia/bone_estradiol.py`.
//
// 11 state variables -> 9 (D, Mo, M1, M2, C1, C2, Cb, Mb, E2). Removed:
//
//   * the equations of Cm and Mc;
//   * the parameters of Cm: kpm, apm, apm1, K_lm, dm, amb1 (and with them the
//     auxiliary functions Am and F1);
//   * the parameters of Mc: p_cs, q_cd1, q_cd2;
//   * the term k_3 * Cm in C2 (and the parameter k_3);
//   * the term F1 * Cm in Cb, replaced by the constant source Es.
//
// Two points of this file are worth knowing, both written up in
// `docs/questoes-em-aberto.md` ("Encontrado durante o desenvolvimento", items
// 34, 35 and 38) and in the table at the end of
// `referencia/simplificacao_2026-04-22.md`:
//
//   1. The note writes the original equation of Cb as
//      `dCb/dt = Es + Ab*Cb*(1 - Cb)/klb - F1*Cm - db*Cb`, and the
//      simplification drops `F1*Cm` from it. `Es` is `E2`, a typo (confirmed by
//      Isabella, 2026-10-11), hence the `E2` below. That source term does not
//      exist in `referencia/bone_estradiol.py`, which is a question about the
//      ORIGINAL model, not about this file (item 38). What matters here is that
//      `F1*Cm` was the only term of `dCb/dt` without a factor of `Cb`: with no
//      source at all, Cb and Mb would stay identically zero. Its magnitude
//      barely matters, since Cb settles at the non-zero fixed point of the
//      logistic, k_lb * (1 - d_b / Ab), around 150,600.
//   2. The equation of C1 follows the NOTE, without the E2 that multiplies the
//      degradation term in the original code. This is a difference between the
//      note and the code, not a consequence of removing Cm and Mc.
//
// No threshold was touched because of either.

model verly_simp1

  // --- Parameters (same names and values as in the original) -------------
  ke_1  = 3.0;
  ke_2  = 3.0;
  a_ed  = 4.71e6;    // declared in the original code but never used (see aed)
  d_o   = 0.156;
  k_12  = 0.075;
  k_21  = 0.005;
  d_1   = 0.121;
  d_2   = 0.163;
  k_o   = 0.0000005;
  k_1   = 0.0000083;
  d_c1  = 0.2;
  k_2   = 0.00000372;
  d_c2  = 0.25;
  k_lb  = 1000000.0;
  d_b   = 0.15;
  p_bs  = 0.00000005;
  q_bd  = 0.00000005;
  aed   = 4.71e6;    // the one actually passed to RD in the original code
  kmax  = 0.015;
  Mmax  = 6.0e5;
  k_01  = 0.55;
  a_01  = 0.01;
  k_02  = 0.3;
  a_02  = 0.005;
  a_12  = 0.025;
  a_22  = 0.1;
  kpb   = 0.2202;
  apb   = 10.0;
  ae2   = 0.5;
  de2   = 0.03;

  E2max = 0.060;

  // --- Auxiliary functions (Am and F1 are gone with Cm) -------------------
  M  := Mo + M1 + M2;                                  // total macrophages
  RD := D / (aed + D);                                 // phagocytosis rate
  RM := kmax * (1 - M / Mmax);                         // migration of Mo
  G1 := k_01 * (C1 / (a_01 + C1));                     // Mo -> M1
  G2 := k_02 * (C2 / (a_02 + C2));                     // Mo -> M2
  H1 := a_12 / (a_12 + C2);                            // inhibition by C2
  H2 := a_22 / (a_22 + C2);                            // inhibition by C2
  Ab := kpb * (apb / (apb + C1));                      // proliferation of Cb

  // --- Equations (one per state variable) ---------------------------------
  D'  = -RD * (ke_1 * M1 + ke_2 * M2);
  Mo' = RM - G1 * Mo - G2 * Mo - (d_o * Mo);
  M1' = G1 * Mo + (k_21 * M2) - (k_12 * M1) - (d_1 * M1);
  M2' = G2 * Mo + (k_12 * M1) - (k_21 * M2) - (d_2 * M2);
  C1' = H1 * (k_o * D + k_1 * M1) - (d_c1 * C1);       // note: no E2 (open question 35)
  C2' = H2 * (k_2 * M2) * E2 - (d_c2 * C2);            // without k_3 * Cm
  Cb' = E2 + Ab * Cb * (1 - (Cb / k_lb)) - (d_b * Cb); // note's Cb, minus F1 * Cm
  Mb' = (p_bs - (q_bd * Mb)) * Cb;
  E2' = ((E2max - E2) / E2max) * ae2 * E2 - de2 * E2;

  // --- Initial conditions (same values as in the original) ----------------
  D  = 1000000.0;
  Mo = 4000.0;
  M1 = 0.0;
  M2 = 0.0;
  C1 = 0.0;
  C2 = 0.0;
  Cb = 0.0;
  Mb = 0.0;
  E2 = 0.060;

end
