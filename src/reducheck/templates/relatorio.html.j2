<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titulo }}</title>
<style>
  :root {
    --tinta: #1a1a1a; --fundo: #ffffff; --suave: #5a5a5a; --linha: #dcdcdc;
    --passou: #1a7f37; --falhou: #b3261e; --ressalva: #9a6700;
  }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--tinta); background: var(--fundo); margin: 0 auto; padding: 2rem 1rem;
    max-width: 52rem; line-height: 1.5;
  }
  h1 { font-size: 1.5rem; margin: 0 0 1rem; }
  h2 { font-size: 1.1rem; margin: 2rem 0 0.5rem; border-bottom: 1px solid var(--linha);
       padding-bottom: 0.25rem; }
  .veredito { display: inline-block; padding: 0.4rem 0.9rem; border-radius: 0.3rem;
              font-size: 1.2rem; font-weight: 700; color: #fff; }
  .veredito.aprovado { background: var(--passou); }
  .veredito.ressalvas { background: var(--ressalva); }
  .veredito.reprovado { background: var(--falhou); }
  .resumo { margin: 0.75rem 0 0; color: var(--suave); }
  .resumo strong { color: var(--tinta); }
  table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--linha);
           vertical-align: top; }
  th { font-weight: 600; background: #f6f6f6; }
  td.numero { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  tr.falhou td { background: #fdf2f1; }
  .passou { color: var(--passou); font-weight: 600; }
  .falhou { color: var(--falhou); font-weight: 600; }
  .descricao { display: block; color: var(--suave); font-size: 0.85rem; }
  ul { padding-left: 1.2rem; }
  li { margin-bottom: 0.35rem; }
  figure { margin: 1.5rem 0; }
  figure img { width: 100%; height: auto; border: 1px solid var(--linha); }
  figcaption { color: var(--suave); font-size: 0.85rem; margin-top: 0.3rem; }
  .nota { color: var(--suave); font-size: 0.85rem; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem;
       font-size: 0.9rem; }
  dt { color: var(--suave); }
  dd { margin: 0; }
  [hidden] { display: none !important; }
  .filtro { position: sticky; top: 0; z-index: 1; background: var(--fundo);
            border-bottom: 1px solid var(--linha); padding: 0.6rem 0; margin-top: 1.5rem;
            display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .filtro .rotulo { color: var(--suave); font-size: 0.85rem; margin-right: 0.3rem; }
  .filtro button { font: inherit; font-size: 0.85rem; padding: 0.15rem 0.7rem;
                   border: 1px solid var(--linha); border-radius: 1rem; background: var(--fundo);
                   color: var(--tinta); cursor: pointer; }
  .filtro button[aria-pressed="true"] { background: var(--tinta); border-color: var(--tinta);
                                        color: var(--fundo); }
  .filtro button:focus-visible { outline: 2px solid var(--tinta); outline-offset: 2px; }
  .filtro .estado { flex-basis: 100%; color: var(--suave); font-size: 0.8rem; }
  dl.metricas { display: block; }
  dl.metricas dt { color: var(--tinta); font-weight: 600; margin-top: 0.8rem;
                   font-family: ui-monospace, Consolas, monospace; }
  dl.metricas dd { margin: 0.15rem 0 0; }
</style>
</head>
<body>
<h1>{{ titulo }}</h1>

<p><span class="veredito {{ classe_do_veredito }}">{{ veredito.nivel }}</span></p>
<p class="resumo">
  Critérios atendidos: <strong>{{ passados }} de {{ total }} ({{ porcentagem }}%)</strong><br>
  Obrigatórios: <strong>{{ obrigatorios.passados }} de {{ obrigatorios.total }}</strong> |
  Desejáveis: <strong>{{ desejaveis.passados }} de {{ desejaveis.total }}</strong>
</p>
{% if nota_dos_niveis %}
<p class="nota">{{ nota_dos_niveis }}</p>
{% endif %}

{% if variaveis_do_filtro | length > 1 %}
<div class="filtro" id="filtro" role="group" aria-label="Filtrar por variável" hidden>
  <span class="rotulo">Variáveis:</span>
  <button type="button" data-filtro="" aria-pressed="true">Todas</button>
  {% for nome in variaveis_do_filtro %}
  <button type="button" data-filtro="{{ nome }}" aria-pressed="false">{{ nome }}</button>
  {% endfor %}
  <span class="estado" id="filtro-estado">Mostrando todas as variáveis.</span>
</div>
{% endif %}

<h2>Critérios</h2>
<table>
  <thead>
    <tr>
      <th>Critério</th><th>Variável</th><th>Valor</th><th>Limite</th>
      <th>Tipo</th><th>Resultado</th>
    </tr>
  </thead>
  <tbody data-filtravel>
  {% for item in criterios %}
    <tr class="{{ item.resultado }}">
      <td>{{ item.metrica }}{% if item.descricao %}<span class="descricao">{{ item.descricao }}</span>{% endif %}</td>
      <td{% if item.filtro %} data-variavel="{{ item.filtro }}"{% endif %}>{{ item.variavel }}</td>
      <td class="numero">{{ item.valor }}</td>
      <td class="numero">{{ item.limite }}</td>
      <td>{{ item.tipo }}</td>
      <td class="{{ item.resultado }}">{{ item.resultado }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="nota vazio-filtro" hidden>Nenhum critério nas variáveis escolhidas.</p>
<p class="nota">As falhas vêm primeiro; na ordem em que foram declaradas dentro de cada grupo.</p>

{% if metricas %}
<h2>O que cada métrica mede</h2>
<p class="nota">Os valores da tabela são erros: quanto menor, mais o simplificado se parece com
o original. Um critério passa quando o valor fica abaixo do limite ou igual a ele.</p>
<dl class="metricas">
  {% for metrica in metricas %}
  <dt>{{ metrica.nome }}</dt><dd>{{ metrica.texto }}</dd>
  {% endfor %}
</dl>
{% endif %}

<h2>Razões</h2>
{% if razoes_por_variavel %}
<ul data-filtravel>
  {% for variavel, razao in razoes_por_variavel %}<li{% if variavel %} data-variavel="{{ variavel }}"{% endif %}>{{ razao }}</li>{% endfor %}
</ul>
<p class="vazio-filtro" hidden>Nenhum critério falhou nas variáveis escolhidas.</p>
{% else %}
<p>Nenhum critério falhou.</p>
{% endif %}

<h2>Avisos</h2>
{% if avisos_por_variavel %}
<ul data-filtravel>
  {% for variavel, aviso in avisos_por_variavel %}<li{% if variavel %} data-variavel="{{ variavel }}"{% endif %}>{{ aviso }}</li>{% endfor %}
</ul>
<p class="vazio-filtro" hidden>Nenhum aviso nas variáveis escolhidas.</p>
{% else %}
<p>Nenhum aviso.</p>
{% endif %}

{% if qualitativo %}
<h2>Análise qualitativa</h2>
{% if qualitativo.equilibrio %}
<table>
  <thead>
    <tr>
      <th>Variável</th><th>Original</th><th>Simplificado</th>
      <th>Erro relativo</th><th>Limite</th><th>Resultado</th>
    </tr>
  </thead>
  <tbody>
  {% for linha in qualitativo.equilibrio %}
    <tr class="{{ linha.resultado }}">
      <td{% if linha.filtro %} data-variavel="{{ linha.filtro }}"{% endif %}>{{ linha.variavel }}</td>
      <td class="numero">{{ linha.original }}</td>
      <td class="numero">{{ linha.simplificado }}</td>
      <td class="numero">{{ linha.erro }}</td>
      <td class="numero">{{ linha.limite }}</td>
      <td class="{{ linha.resultado }}">{{ linha.resultado }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="nota">Equilíbrio das variáveis mapeadas, na combinação declarada em cada modelo.</p>
{% endif %}
<table>
  <thead>
    <tr>
      <th>Modelo</th><th>Classificação</th><th>Autovalores dominantes</th>
      <th>Equilíbrio alcançado em</th><th>Resíduo relativo</th><th>Jacobiana</th>
    </tr>
  </thead>
  <tbody>
  {% for modelo in qualitativo.modelos %}
    <tr>
      <td>{{ modelo.papel }}</td>
      <td>{{ modelo.classificacao }}</td>
      <td class="numero">{{ modelo.autovalores | join(", ") }}</td>
      <td class="numero">{{ modelo.instante }}</td>
      <td class="numero">{{ modelo.residuo }}</td>
      <td>{{ modelo.metodo_da_jacobiana }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="nota">Os três autovalores de maior parte real da Jacobiana no equilíbrio. {{ qualitativo.aviso }}</p>
{% if qualitativo.nota %}
<p class="nota">{{ qualitativo.nota }}</p>
{% endif %}

{% endif %}
<h2>Gráficos</h2>
{% if graficos %}
<div data-filtravel>
  {% for grafico in graficos %}
  <figure data-variavel="{{ grafico.variavel }}">
    <img alt="Trajetórias e erro da variável {{ grafico.variavel }}"
         src="data:image/png;base64,{{ grafico.base64 }}">
    <figcaption>
      {{ grafico.variavel }}: original (linha contínua) e simplificado (tracejada), com o
      erro absoluto ao longo do tempo embaixo.
      {%- if grafico.combinacao %} Comparação: {{ grafico.combinacao }}.{% endif %}
      Arquivo: {{ grafico.arquivo }}.
    </figcaption>
  </figure>
  {% endfor %}
</div>
<p class="vazio-filtro" hidden>Nenhum gráfico nas variáveis escolhidas.</p>
{% else %}
<p>Nenhuma variável mapeada para desenhar.</p>
{% endif %}

<h2>Dados da execução</h2>
<dl>
  {% for rotulo, valor in execucao %}
  <dt>{{ rotulo }}</dt><dd>{{ valor }}</dd>
  {% endfor %}
</dl>
<script>
/* Filtro por variável. Sem JavaScript a barra continua escondida e tudo fica visível. */
(function () {
  var barra = document.getElementById("filtro");
  if (!barra) return;
  barra.hidden = false;
  var botoes = Array.prototype.slice.call(barra.querySelectorAll("button[data-filtro]"));
  var estado = document.getElementById("filtro-estado");
  var escolhidas = [];

  function aplicar() {
    var todas = escolhidas.length === 0;
    document.querySelectorAll("[data-variavel]").forEach(function (el) {
      var alvo = el.tagName === "TD" ? el.closest("tr") : el;
      alvo.hidden = !(todas || escolhidas.indexOf(el.getAttribute("data-variavel")) >= 0);
    });
    document.querySelectorAll("[data-filtravel]").forEach(function (lista) {
      var visiveis = Array.prototype.some.call(lista.children, function (filho) {
        return !filho.hidden;
      });
      var aviso = lista.tagName === "TBODY"
        ? lista.closest("table").nextElementSibling
        : lista.nextElementSibling;
      if (aviso && aviso.classList.contains("vazio-filtro")) aviso.hidden = visiveis;
    });
    botoes.forEach(function (botao) {
      var nome = botao.getAttribute("data-filtro");
      var ligado = nome === "" ? todas : escolhidas.indexOf(nome) >= 0;
      botao.setAttribute("aria-pressed", String(ligado));
    });
    estado.textContent = todas
      ? "Mostrando todas as variáveis."
      : "Mostrando: " + escolhidas.join(", ") +
        ". Itens que valem para o modelo inteiro continuam visíveis.";
  }

  botoes.forEach(function (botao) {
    botao.addEventListener("click", function () {
      var nome = botao.getAttribute("data-filtro");
      if (nome === "") {
        escolhidas = [];
      } else if (escolhidas.indexOf(nome) >= 0) {
        escolhidas = escolhidas.filter(function (outra) { return outra !== nome; });
      } else {
        escolhidas.push(nome);
      }
      aplicar();
    });
  });
})();
</script>
</body>
</html>
